# logs-interceptor V3 Configuration (LOGS_*)

# Required
LOGS_URL=http://localhost:3100/loki/api/v1/push
LOGS_TENANT=my-tenant
LOGS_APP_NAME=my-application

# Optional auth
LOGS_TOKEN=your-bearer-token-here

# App metadata
LOGS_ENVIRONMENT=development
LOGS_APP_VERSION=1.0.0

# Labels
LOGS_LABEL_SERVICE=api
LOGS_LABEL_ENVIRONMENT=dev

# Transport
LOGS_COMPRESSION=gzip
LOGS_COMPRESSION_LEVEL=6
LOGS_COMPRESSION_THRESHOLD=1024
LOGS_USE_WORKERS=true
LOGS_MAX_WORKERS=2
LOGS_CONNECTION_POOLING=true
LOGS_MAX_SOCKETS=50
LOGS_TIMEOUT=10000
LOGS_MAX_RETRIES=3
LOGS_RETRY_DELAY=1000

# Buffer
LOGS_BUFFER_MAX_SIZE=100
LOGS_BUFFER_FLUSH_INTERVAL=5000
LOGS_BUFFER_MAX_MEMORY_MB=50
LOGS_BUFFER_MAX_AGE=30000
LOGS_BUFFER_AUTO_FLUSH=true

# Filter
LOGS_FILTER_LEVELS=debug,info,warn,error,fatal
LOGS_FILTER_SAMPLING_RATE=1.0
LOGS_FILTER_SANITIZE=true
LOGS_FILTER_MAX_MESSAGE_LENGTH=8192

# Circuit breaker
LOGS_CIRCUIT_BREAKER_ENABLED=true
LOGS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=50
LOGS_CIRCUIT_BREAKER_RESET_TIMEOUT=30000
LOGS_CIRCUIT_BREAKER_HALF_OPEN_REQUESTS=3

# DLQ
LOGS_DLQ_ENABLED=true
LOGS_DLQ_TYPE=file
LOGS_DLQ_MAX_SIZE=1000
LOGS_DLQ_MAX_RETRIES=3
LOGS_DLQ_BASE_PATH=./.logs-dlq

# Performance
LOGS_MAX_CONCURRENT_FLUSHES=3
LOGS_WORKER_TIMEOUT=30000

# Features
LOGS_INTERCEPT_CONSOLE=true
LOGS_PRESERVE_ORIGINAL_CONSOLE=true
LOGS_ENABLE_METRICS=true
LOGS_ENABLE_HEALTH_CHECK=true
LOGS_DEBUG=false
LOGS_SILENT_ERRORS=false
LOGS_ENABLED=true

# Optional auto-init when importing the package
# LOGS_AUTO_INIT=true
