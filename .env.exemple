# logs-interceptor Configuration
# Copy this file to .env and update with your values

# Required Configuration
LOGS_INTERCEPTOR_URL=http://localhost:3100/loki/api/v1/push
LOGS_INTERCEPTOR_TENANT_ID=my-tenant
LOGS_INTERCEPTOR_APP_NAME=my-application

# Optional Authentication
LOGS_INTERCEPTOR_AUTH_TOKEN=your-bearer-token-here

# Application Metadata
LOGS_INTERCEPTOR_ENVIRONMENT=development
LOGS_INTERCEPTOR_VERSION=1.0.0

# Static Labels (comma-separated key=value pairs)
LOGS_INTERCEPTOR_LABELS=service=api,datacenter=us-east-1,team=backend

# Buffer Configuration
LOGS_INTERCEPTOR_BUFFER_SIZE=100
LOGS_INTERCEPTOR_FLUSH_INTERVAL=5000

# Log Filtering
LOGS_INTERCEPTOR_LOG_LEVEL=debug,info,warn,error,fatal
LOGS_INTERCEPTOR_SAMPLING_RATE=1.0

# Feature Flags
LOGS_INTERCEPTOR_ENABLED=true
LOGS_INTERCEPTOR_DEBUG=false

# Auto-initialization Control
LOGS_INTERCEPTOR_FAIL_ON_ERROR=false

# Example usage with NODE_OPTIONS:
# NODE_OPTIONS="--require logs-interceptor/preload" node app.js