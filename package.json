{
  "name": "logs-interceptor",
  "version": "3.0.0",
  "description": "High-performance, production-ready log interceptor for Node.js applications with Loki integration. Built with Clean Architecture principles. Supports Node.js, Browser, and Node-RED.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "preload.js",
    "RECOVERY.md",
    "AUDIT-LEGACY.md",
    "AUDIT-LEGACY-FOLLOWUP.md",
    "AUDIT-MATCHER.md"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "build:watch": "tsc --watch",
    "test": "node --test --test-reporter=tap tests/*.test.cjs",
    "test:watch": "node --test --watch tests/*.test.cjs",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "dev": "ts-node src/index.ts",
    "test:runtime": "npm run build && node --test tests/*.test.cjs",
    "test:types": "tsc --strict --skipLibCheck --noEmit --module NodeNext --moduleResolution NodeNext --target ES2020 tests/typescript-contract.ts",
    "prepublishOnly": "npm run build && npm run test:types && npm test && node tests/jest-port-inventory.cjs"
  },
  "keywords": [
    "loki",
    "logging",
    "observability",
    "console-interceptor",
    "telemetry",
    "grafana",
    "node-red",
    "clean-architecture",
    "typescript",
    "enterprise"
  ],
  "author": "Leonardo Zwirtes",
  "license": "MIT",
  "dependencies": {
    "@eslint-community/regexpp": "4.12.2",
    "@opentelemetry/api": "^1.9.0",
    "dotenv": "^16.6.1",
    "protobufjs": "^7.6.5",
    "re2js": "2.9.1",
    "snappy": "^7.2.2",
    "undici": "^6.29.1",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^9.29.0",
    "morgan": "^1.10.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.54.0",
    "winston": "^3.19.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leozw/logs-interceptor-js.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true
  }
}
