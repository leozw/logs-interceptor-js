{
  "name": "elven-logs-interceptor",
  "version": "2.0.0",
  "description": "High-performance, production-ready log interceptor for Node.js applications with Loki and OTLP collector integration.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist/**/*",
    "preload.js"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "build:watch": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:matcher": "node --test scripts/matcher-security.test.cjs scripts/matcher-contracts.test.cjs",
    "test:consumer": "node scripts/qualify-consumer.cjs",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "dev": "ts-node src/index.ts",
    "prepublishOnly": "npm run lint && npm run build && npm test -- --runInBand && npm run test:matcher && npm run test:consumer"
  },
  "keywords": [
    "loki",
    "logging",
    "observability",
    "console-interceptor",
    "telemetry",
    "grafana",
    "node-red",
    "clean-architecture",
    "typescript",
    "enterprise"
  ],
  "author": "Leonardo Zwirtes",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/core": "~2.12.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.223.0",
    "@opentelemetry/otlp-exporter-base": "^0.223.0",
    "@opentelemetry/resources": "~2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "protobufjs": "^7.6.5",
    "@eslint-community/regexpp": "4.12.2",
    "re2js": "2.9.1",
    "snappy": "^7.2.2",
    "undici": "^6.29.1",
    "winston-transport": "^4.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^10.13.0",
    "jest": "^30.0.3",
    "morgan": "^1.10.1",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.54.0",
    "winston": "^3.19.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leozw/logs-interceptor-js.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "provenance": true,
    "tag": "next"
  }
}
